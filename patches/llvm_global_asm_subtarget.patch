+static void getGlobalAsmSubtarget(const Module &M, std::string &CPU,
+                                  std::string &Features) {
+  const NamedMDNode *NMD = M.getNamedMetadata("llvm.global_asm.subtarget");
+  if (!NMD && !M.isMaterialized()) {
+    // Lazy bitcode readers defer metadata past addModule(); materialize on demand.
+    consumeError(const_cast<Module &>(M).materializeMetadata());
+    NMD = M.getNamedMetadata("llvm.global_asm.subtarget");
+  }
+  if (!NMD)
+    return;
+
+  for (const MDNode *Op : NMD->operands()) {
+    if (!Op || Op->getNumOperands() < 2)
+      continue;
+    if (auto *MDS = dyn_cast_or_null<MDString>(Op->getOperand(0))) {
+      StringRef EntryCPU = MDS->getString();
+      if (!EntryCPU.empty() && (CPU.empty() || CPU == "generic"))
+        CPU = EntryCPU.str();
+    }
+    if (auto *MDS = dyn_cast_or_null<MDString>(Op->getOperand(1))) {
+      StringRef EntryFS = MDS->getString();
+      if (!EntryFS.empty()) {
+        if (!Features.empty())
+          Features += ',';
+        Features += EntryFS;
+      }
+    }
+  }
+}
